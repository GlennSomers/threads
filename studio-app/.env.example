# Password for the app (everyone who knows it can use the Studio and spend your Groq/GitHub minutes)
STUDIO_PASSWORD=choose-something-long
# Random string used to sign the login cookie
STUDIO_SECRET=another-long-random-string
# Vercel Blob store (Vercel > Storage > Create > Blob; connecting it to the project adds this for you)
BLOB_READ_WRITE_TOKEN=
# Fine-grained GitHub token for this repo: Actions (read and write). Starts the heavy jobs.
GH_DISPATCH_TOKEN=
GH_REPO=GlennSomers/threads
# Optional. Without it the edit chat runs Claude Code in GitHub Actions with your Claude login (repo secret CLAUDE_CODE_OAUTH_TOKEN).
# With it, the chat calls the API directly (faster, billed as API usage). STUDIO_CHAT_MODEL picks another model.
ANTHROPIC_API_KEY=
# Local dev only: keep everything in a folder instead of Blob
# STORAGE=fs
