# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables.

# The password you'll type to open the app. Use something long.
APP_PASSWORD=

# Fine-grained GitHub token, limited to this one repo, with:
#   Contents: Read and write
#   Actions:  Read and write
GITHUB_TOKEN=

# Where the drafts live
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
